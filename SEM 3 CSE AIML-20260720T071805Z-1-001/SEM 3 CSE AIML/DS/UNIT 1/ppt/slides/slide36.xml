<p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Title 1"/><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="title"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="en-IN" dirty="0"/><a:t>Structures</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Content Placeholder 2"/><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr><a:normAutofit fontScale="85000" lnSpcReduction="20000"/></a:bodyPr><a:lstStyle/><a:p><a:pPr><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-US" dirty="0"/><a:t>Structures cannot be directly checked for equality or inequality. So, we can write a function to </a:t></a:r><a:r><a:rPr lang="en-US" dirty="0" smtClean="0"/><a:t>do this:</a:t></a:r></a:p><a:p><a:pPr><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft></a:pPr><a:endParaRPr lang="en-US" dirty="0" smtClean="0"/></a:p><a:p><a:pPr><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" dirty="0"/><a:t>if(</a:t></a:r><a:r><a:rPr lang="en-IN" dirty="0" err="1"/><a:t>humansEqual</a:t></a:r><a:r><a:rPr lang="en-IN" dirty="0"/><a:t>(person1,person2))</a:t></a:r></a:p><a:p><a:pPr><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-US" dirty="0" err="1"/><a:t>printf</a:t></a:r><a:r><a:rPr lang="en-US" dirty="0"/><a:t>("two human beings are same");</a:t></a:r></a:p><a:p><a:pPr><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" dirty="0"/><a:t>else</a:t></a:r></a:p><a:p><a:pPr><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-US" dirty="0" err="1"/><a:t>printf</a:t></a:r><a:r><a:rPr lang="en-US" dirty="0"/><a:t>("two human beings are different");</a:t></a:r></a:p><a:p><a:pPr><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" dirty="0" smtClean="0"/><a:t>---------------------------------------------------------------------------------------------------</a:t></a:r><a:endParaRPr lang="en-IN" dirty="0"/></a:p><a:p><a:pPr><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" dirty="0" err="1"/><a:t>int</a:t></a:r><a:r><a:rPr lang="en-IN" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="en-IN" dirty="0" err="1"/><a:t>humansEqual</a:t></a:r><a:r><a:rPr lang="en-IN" dirty="0"/><a:t>(</a:t></a:r><a:r><a:rPr lang="en-IN" dirty="0" err="1"/><a:t>humanBeing</a:t></a:r><a:r><a:rPr lang="en-IN" dirty="0"/><a:t> person1,humanBeing person2)</a:t></a:r></a:p><a:p><a:pPr><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" dirty="0"/><a:t>{</a:t></a:r></a:p><a:p><a:pPr><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" dirty="0"/><a:t>if(</a:t></a:r><a:r><a:rPr lang="en-IN" dirty="0" err="1"/><a:t>strcmp</a:t></a:r><a:r><a:rPr lang="en-IN" dirty="0"/><a:t>(person1.name,person2.name))</a:t></a:r></a:p><a:p><a:pPr><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft></a:pPr><a:r><a:rPr lang="en-IN" dirty="0"/><a:t>return 0</a:t></a:r><a:r><a:rPr lang="en-IN" dirty="0" smtClean="0"/><a:t>;</a:t></a:r></a:p><a:p><a:pPr><a:spcBef><a:spcPts val="