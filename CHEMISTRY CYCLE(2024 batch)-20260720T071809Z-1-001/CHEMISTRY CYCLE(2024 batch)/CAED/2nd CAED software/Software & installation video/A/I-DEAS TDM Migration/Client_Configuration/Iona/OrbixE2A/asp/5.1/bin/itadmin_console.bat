REM JAVA_HOME check

if "%JAVA_HOME%"=="" goto :no_jhome
if NOT exist "%JAVA_HOME%\bin\java.exe" goto :no_jbin


REM Look for the following parameters:
REM -launcher_help, -version, -show_java_command, -bg, -background
REM -ORBdomain_name, -ORBconfig_domains_dir, -ORBconfig_dir, 
REM -ORBproduct_dir, -ORBlicense_file

set it_param_list=
set it_show_java_command=0
set it_start_in_bg=0
set it_my_name=%0
set it_ORBdomain_name=
set it_ORBconfig_domains_dir=
set it_ORBconfig_dir=
set it_ORBproduct_dir=
set it_ORBlicense_file=

:loop
if x%1==x goto :exit_lp
if %1==-launcher_help goto :help
if %1==-version goto :version
if %1==-show_java_command goto :show_cmd
if %1==-bg goto :st_bg
if %1==-background goto :st_bg
if %1==-ORBdomain_name goto :st_dmnm
if %1==-ORBconfig_domains_dir goto :st_cfgdm
if %1==-ORBconfig_dir goto :st_cfg
if %1==-ORBproduct_dir goto :st_prd
if %1==-ORBlicense_file goto :st_lic

set it_param_list=%it_param_list% %1
goto :shift_lp

:show_cmd
set it_show_java_command=1
goto :shift_lp

:st_bg
set it_start_in_bg=1
goto :shift_lp

:st_dmnm
set it_ORBdomain_name=%2
goto :var_set

:st_cfgdm
set it_ORBconfig_domains_dir=%2
goto :var_set

:st_cfg
set it_ORBconfig_dir=%2
goto :var_set

:st_prd
set it_ORBproduct_dir=%2
goto :var_set

:st_lic
set it_ORBlicense_file=%2
goto :var_set

:var_set
set it_param_list=%it_param_list% %1 %2
shift

:shift_lp
shift
goto :loop

:exit_lp

REM Now let's see if we need to transform some env variables
REM in parameters
REM

if NOT x%it_ORBdomain_name%==x goto :cfgdm
if NOT "%IT_DOMAIN_NAME%"=="" set it_param_list=%it_param_list% -ORBdomain_name %IT_DOMAIN_NAME%

:cfgdm
if NOT x%it_ORBconfig_domains_dir%==x goto :cfg
if NOT "%IT_CONFIG_DOMAINS_DIR%"=="" set it_param_list=%it_param_list% -ORBconfig_domains_dir "%IT_CONFIG_DOMAINS_DIR%"

:cfg
if NOT x%it_ORBconfig_dir%==x goto :prd
if NOT "%IT_CONFIG_DIR%"=="" set it_param_list=%it_param_list% -ORBconfig_dir "%IT_CONFIG_DIR%"

:prd
if NOT x%it_ORBproduct_dir%==x goto :lic
if NOT "%IT_PRODUCT_DIR%"=="" set it_param_list=%it_param_list% -ORBproduct_dir "%IT_PRODUCT_DIR%"

:lic
if NOT x%it_ORBlicense_file%==x goto :cp
if NOT "%IT_LICENSE_FILE%"=="" set it_param_list=%it_param_list% -ORBlicense_file "%IT_LICENSE_FILE%"

REM
REM Compute my_classpath
REM

:cp

set it_my_classpath=%IT_CLASSPATH%
if NOT "%it_my_classpath%"=="" goto :launch

set it_my_product_dir=%it_ORBproduct_dir%
if x%it_my_product_dir%==x goto :prd_env

REM Unfortunately, we can't remove the surrounding quotes on Windows 98
REM (or Windows NT without command extensions) so we don't support 
REM -ORBproduct_dir with quotes on Windows 98 (NT without command extensions)
REM unless it matches the value of IT_PRODUCT_DIR

if "%OS%"=="Windows_NT" set it_my_product_dir=%it_ORBproduct_dir:"=%
if %it_ORBproduct_dir%=="%IT_PRODUCT_DIR%" set it_my_product_dir=%IT_PRODUCT_DIR%

:prd_env

if "%it_my_product_dir%"=="" set it_my_product_dir=%IT_PRODUCT_DIR%
if "%it_my_product_dir%"=="" set it_my_product_dir=C:\Program Files\IONA

set it_libdir=%it_my_product_dir%\asp\5.1\lib


if NOT exist "%it_libdir%\runtime\ipa.jar" echo %it_libdir%\runtime\ipa.jar not found!
if NOT exist "%it_libdir%\runtime\ipa.jar" goto :exit
	
if NOT exist "%it_libdir%\runtime\itgui.jar" echo %it_libdir%\runtime\itgui.jar not found!
if NOT exist "%it_libdir%\runtime\itgui.jar" goto :exit
	
if NOT exist "%it_libdir%\orbix2000.jar" echo %it_libdir%\orbix2000.jar not found!
if NOT exist "%it_libdir%\orbix2000.jar" goto :exit
	
if NOT exist "%it_libdir%\third_party\jmxri.jar" echo %it_libdir%\third_party\jmxri.jar not found!
if NOT exist "%it_libdir%\third_party\jmxri.jar" goto :exit
	
if NOT exist "%it_libdir%\third_party\xerces.jar" echo %it_libdir%\third_party\xerces.jar not found!
if NOT exist "%it_libdir%\third_party\xerces.jar" goto :exit
	

set it_my_classpath=%it_libdir%\runtime\ipa.jar;%it_libdir%\runtime\itgui.jar;%it_libdir%\orbix2000.jar;%it_libdir%\third_party\jmxri.jar;%it_libdir%\third_party\xerces.jar



set it_etcdir=%it_my_product_dir%\asp\5.1\etc
set it_my_classpath=%it_my_classpath%;%it_etcdir%

:launch

set java_flags=

if %it_show_java_command%==1 echo on

if %it_start_in_bg%==0 "%JAVA_HOME%\bin\java" %java_flags% -Dorg.omg.CORBA.ORBClass=com.iona.corba.art.artimpl.ORBImpl -Dorg.omg.CORBA.ORBSingletonClass=com.iona.corba.art.artimpl.ORBSingleton -classpath "%it_my_classpath%" -DIT_POLL_PROCESS=false com.iona.management.tetris.main.ConsoleMain -props resources/iaconsolemain %it_param_list% 

if %it_start_in_bg%==1 start "" "%JAVA_HOME%\bin\javaw" %java_flags% -Dorg.omg.CORBA.ORBClass=com.iona.corba.art.artimpl.ORBImpl -Dorg.omg.CORBA.ORBSingletonClass=com.iona.corba.art.artimpl.ORBSingleton -classpath "%it_my_classpath%" -DIT_POLL_PROCESS=false com.iona.management.tetris.main.ConsoleMain -props resources/iaconsolemain %it_param_list% 


@if %it_show_java_command%==1 echo off

goto :exit


:help
echo Usage: %it_my_name% [-launcher_help] [-ORBconfig_dir config_dir_value] [-ORBconfig_domains_dir config_domains_dir_value] [-ORBdomain_name domain_name_value] [-ORBproduct_dir product_dir_value] [-show_java_command] [-version] [other parameters passed to the application]
goto :exit

:version
echo management service 5.1
goto :exit

:no_jhome
echo Please set the environment variable JAVA_HOME to your Java SDK or Runtime Environment v1.3.x (x^>=1) installation directory.
goto :exit

:no_jbin
echo Can't find java.exe in your %JAVA_HOME%\bin directory. Is your JAVA_HOME environment variable set correctly?
goto :exit

:exit

