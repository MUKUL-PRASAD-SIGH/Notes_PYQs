#!/bin/sh
# orbix_profile
#
#  This script is executed by /etc/profile to setup Orbix environment variables
#
IT_PRODUCT_DIR=/misc/orbix/hp/v5.0
IT_DOMAIN_NAME=openideas10
IT_CONFIG_DOMAINS_DIR=/etc/opt/iona/domains
IT_LICENSE_FILE=$IT_PRODUCT_DIR/licenses.txt
JAVA_HOME=/opt/java1.3
export IT_PRODUCT_DIR IT_DOMAIN_NAME IT_CONFIG_DOMAINS_DIR IT_LICENSE_FILE JAVA_HOME

addition="$IT_PRODUCT_DIR/orbix_art/2.0/bin:/etc/opt/iona/bin"
if [ -n "$PATH" ]
then
   if [ `echo $PATH | grep $addition | wc -l` = 0 ]
   then
      PATH=$addition:$PATH
   fi
else
   PATH=$addition
fi
export PATH

addition="$IT_PRODUCT_DIR/shlib:$IT_PRODUCT_DIR/shlib/default"
if [ -n "$SHLIB_PATH" ]
then
   if [ `echo $SHLIB_PATH | grep $addition | wc -l` = 0 ]
   then
      SHLIB_PATH=$addition:$SHLIB_PATH
   fi
else
   SHLIB_PATH=$addition
fi
export SHLIB_PATH

#addition="$IT_PRODUCT_DIR/shlib:$IT_PRODUCT_DIR/shlib/default"
#if [ -n "$LD_LIBRARY_PATH" ]
#then
#   if [ `echo $LD_LIBRARY_PATH | grep $addition | wc -l` = 0 ]
#   then
#      LD_LIBRARY_PATH=$addition:$LD_LIBRARY_PATH
#   fi
#else
#   LD_LIBRARY_PATH=$addition
#fi
#export LD_LIBRARYN32_PATH

addition="$IT_PRODUCT_DIR/orbix_art/2.0/lib/orbix2000.jar"
if [ -n "$CLASSPATH" ]
then
   if [ `echo $CLASSPATH | grep $addition | wc -l` = 0 ]
   then
      CLASSPATH=$addition:$CLASSPATH
   fi
else
   CLASSPATH=$addition
fi
export CLASSPATH

