@echo off

REM JAVA_HOME check


if "%JAVA_HOME%"=="" goto :java_home_not_set

if "%OS%"=="Windows_NT" setlocal

set LOCAL_IT_PRODUCT_DIR=

REM find IT_PRODUCT_DIR
if "%IT_PRODUCT_DIR%"=="" set LOCAL_IT_PRODUCT_DIR=C:\Program Files\IONA
if "%LOCAL_IT_PRODUCT_DIR%"=="" set LOCAL_IT_PRODUCT_DIR=%IT_PRODUCT_DIR%

REM Demo installation directory directory
for /f "tokens=3,*" %%i in ('dir .^|find /i "directory"') do @set LOCAL_IT_DEMO_DIR=%%i

if "%IT_DOMAIN_NAME%"=="" goto :no_domain_name


REM Config Domains Dir Variable
if "%IT_CONFIG_DIR%"=="" set IT_CONFIG_DIR=%LOCAL_IT_PRODUCT_DIR%\etc
if "%IT_CONFIG_DOMAINS_DIR%"=="" set IT_CONFIG_DOMAINS_DIR=%IT_CONFIG_DIR%\domains

if "%IT_LICENSE_FILE%"=="" set LOCAL_IT_LICENSE_FILE=%IT_CONFIG_DIR%\licenses.txt
if "%LOCAL_IT_LICENSE_FILE%"=="" set LOCAL_IT_LICENSE_FILE=%IT_LICENSE_FILE%


REM set up the class path to run ant
set LOCALCLASSPATH=%LOCAL_IT_PRODUCT_DIR%\asp\5.1\lib\third_party\xerces.jar;%LOCAL_IT_PRODUCT_DIR%\asp\5.1\lib\third_party\ant.jar;%JAVA_HOME%\lib\tools.jar;%IT_PRODUCT_DIR%\asp\5.1\lib\product.jar


REM ant.home set to %LOCAL_IT_PRODUCT_DIR%\asp\5.1 as it is apparently only 
REM used to build the path of antRun.bat (ant.home + bin + ant.bat)

:runAnt
"%JAVA_HOME%\bin\java" -classpath "%LOCALCLASSPATH%" -Dasp_product_dir="%LOCAL_IT_PRODUCT_DIR%" -Ddemo_dir="\"%LOCAL_IT_DEMO_DIR%\"" -Ddomain_name="%IT_DOMAIN_NAME%" -Ddomain_dir="\"%IT_CONFIG_DOMAINS_DIR%\"" -Dlicense_file="\"%LOCAL_IT_LICENSE_FILE%\"" org.apache.tools.ant.Main %1 %2 %3 %4 %5 %6 %7 %8 %9

goto :exit

:java_home_not_set
echo Please set the environment variable JAVA_HOME to your Java SDK or Runtime Environment v1.3 installation directory.
goto :exit


:no_domain_name
echo "Unable to determine the domain in which this demo runs."
echo "This script will now terminate."
echo "Please run the <domain_name>_env.bat file generated by itconfigure"
goto :exit

:exit

REM Clean up
set LOCALCLASSPATH=
set LOCAL_IT_PRODUCT_DIR=
set LOCAL_IT_LICENSE_FILE=
set LOCAL_IT_DEMO_DIR=
if "%OS%"=="Windows_NT" endlocal
